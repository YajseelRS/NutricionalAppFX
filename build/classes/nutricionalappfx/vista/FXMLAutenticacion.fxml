<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="440.0" prefWidth="720.0" styleClass="fondo" stylesheets="@../recurso/estilos.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nutricionalappfx.controlador.FXMLAutenticacionController">
   <children>
      <AnchorPane layoutX="40.0" layoutY="40.0" prefHeight="360.0" prefWidth="640.0" styleClass="tarjeta">
         <children>
            <ImageView fitHeight="240.0" fitWidth="240.0" layoutX="30.0" layoutY="60.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../recurso/logo.png" />
               </image>
            </ImageView>
            <VBox layoutX="311.0" layoutY="19.0" prefWidth="290.0" spacing="6.0">
               <children>
                  <Label styleClass="titulo" text="Iniciar sesión" />
                  <Label styleClass="subtitulo" text="Ingresa con tu número de personal" />
                  <Label styleClass="etiqueta" text="No. de personal">
                     <VBox.margin>
                        <Insets top="18.0" />
                     </VBox.margin>
                  </Label>
                  <TextField fx:id="tfNoPersonal" promptText="Ej. np001" />
                  <Label fx:id="lbErrorNoPersonal" minHeight="17.0" styleClass="error" />
                  <Label styleClass="etiqueta" text="Contraseña" />
                  <PasswordField fx:id="pfContrasenia" promptText="Contraseña" />
                  <Label fx:id="lbErrorContrasenia" minHeight="17.0" styleClass="error" />
                  <Button defaultButton="true" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#hableBtnIngresar" styleClass="boton-primario" text="Ingresar">
                     <VBox.margin>
                        <Insets top="8.0" />
                     </VBox.margin>
                  </Button>
               </children>
            </VBox>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
