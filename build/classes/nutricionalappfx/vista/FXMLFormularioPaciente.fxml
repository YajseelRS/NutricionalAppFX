<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="580.0" prefWidth="800.0" styleClass="fondo" stylesheets="@../recurso/estilos.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nutricionalappfx.controlador.FXMLFormularioPacienteController">
   <children>
      <AnchorPane prefHeight="70.0" styleClass="encabezado" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Button layoutX="20.0" layoutY="17.0" mnemonicParsing="false" onAction="#hableBtnCancelar" styleClass="boton-encabezado" text="←" />
            <Label layoutX="80.0" layoutY="22.0" styleClass="titulo-encabezado" text="Formulario de paciente" />
         </children>
      </AnchorPane>
      <VBox layoutX="20.0" layoutY="95.0" prefWidth="760.0" spacing="14.0" styleClass="tarjeta">
         <padding>
            <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
         </padding>
         <children>
            <Label styleClass="seccion" text="Datos personales" />
            <GridPane hgap="10.0" vgap="12.0">
               <columnConstraints>
                  <ColumnConstraints minWidth="10.0" prefWidth="150.0" />
                  <ColumnConstraints minWidth="10.0" prefWidth="190.0" />
                  <ColumnConstraints minWidth="10.0" prefWidth="150.0" />
                  <ColumnConstraints minWidth="10.0" prefWidth="190.0" />
               </columnConstraints>
               <children>
                  <Label styleClass="etiqueta" text="Código paciente" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                  <TextField fx:id="tfCodigo" disable="true" promptText="Automático" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                  <Label styleClass="etiqueta" text="Fecha de nacimiento" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                  <DatePicker fx:id="dpFechaNacimiento" maxWidth="1.7976931348623157E308" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                  <Label styleClass="etiqueta" text="Nombre" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                  <TextField fx:id="tfNombre" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <Label styleClass="etiqueta" text="Apellido paterno" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                  <TextField fx:id="tfApellidoPaterno" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                  <Label styleClass="etiqueta" text="Apellido materno" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                  <TextField fx:id="tfApellidoMaterno" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <Label styleClass="etiqueta" text="Teléfono de contacto" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                  <TextField fx:id="tfTelefono" promptText="10 dígitos" GridPane.columnIndex="3" GridPane.rowIndex="2" />

                  <Label styleClass="etiqueta" text="Correo electrónico" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                  <TextField fx:id="tfCorreo" maxWidth="1.7976931348623157E308" promptText="ejemplo@correo.com" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="3" />
               </children>
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>
            </GridPane>
            <Separator />
            <Label styleClass="seccion" text="Datos físicos" />
            <GridPane hgap="10.0" prefHeight="90.0" prefWidth="710.0" vgap="12.0">
               <columnConstraints>
                  <ColumnConstraints minWidth="10.0" prefWidth="150.0" />
                  <ColumnConstraints maxWidth="269.0" minWidth="10.0" prefWidth="209.0" />
                  <ColumnConstraints maxWidth="145.0" minWidth="10.0" prefWidth="131.0" />
                  <ColumnConstraints minWidth="10.0" prefWidth="190.0" />
               </columnConstraints>
               <children>
                  <Label styleClass="etiqueta" text="Sexo" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                  <HBox alignment="CENTER_LEFT" spacing="18.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                     <children>
                        <RadioButton fx:id="rbFemenino" mnemonicParsing="false" prefHeight="21.0" prefWidth="109.0" text="Femenino">
                           <toggleGroup>
                              <ToggleGroup fx:id="tgSexo" />
                           </toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="rbMasculino" mnemonicParsing="false" prefHeight="21.0" prefWidth="112.0" text="Masculino" toggleGroup="$tgSexo" />
                     </children>
                  </HBox>
                  <Label prefHeight="21.0" prefWidth="132.0" styleClass="etiqueta" text="Altura (cm)" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                  <TextField fx:id="tfAltura" promptText="Ej. 165" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                  <Label styleClass="etiqueta" text="Peso inicial (kg)" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                  <TextField fx:id="tfPesoInicial" promptText="Ej. 62.5" GridPane.columnIndex="1" GridPane.rowIndex="1" />
               </children>
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>
            </GridPane>
            <HBox alignment="CENTER_RIGHT" spacing="10.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#hableBtnGuardar" prefWidth="110.0" styleClass="boton-primario" text="Guardar" />
                  <Button mnemonicParsing="false" onAction="#hableBtnCancelar" prefWidth="110.0" styleClass="boton-secundario" text="Cancelar" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
