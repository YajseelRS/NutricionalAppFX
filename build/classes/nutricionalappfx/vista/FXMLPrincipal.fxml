<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="560.0" prefWidth="800.0" styleClass="fondo" stylesheets="@../recurso/estilos.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nutricionalappfx.controlador.FXMLPrincipalController">
   <children>
      <AnchorPane prefHeight="70.0" styleClass="encabezado" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label layoutX="30.0" layoutY="22.0" styleClass="titulo-encabezado" text="Menú principal" />
            <Button layoutX="650.0" layoutY="17.0" mnemonicParsing="false" onAction="#hableBtnCerrarSesion" styleClass="boton-encabezado" text="Cerrar sesión" AnchorPane.rightAnchor="30.0" />
         </children>
      </AnchorPane>
      <Label fx:id="lbNombre" layoutX="50.0" layoutY="100.0" styleClass="titulo" text="Bienvenido(a)" />
      <Label fx:id="lbRol" layoutX="52.0" layoutY="145.0" styleClass="subtitulo" text="Rol" />
      <FlowPane hgap="20.0" layoutX="50.0" layoutY="200.0" prefWrapLength="700.0" vgap="20.0">
         <children>
            <Button fx:id="btnColaboradores" mnemonicParsing="false" onAction="#hableBtnColaboradores" prefHeight="110.0" prefWidth="220.0" styleClass="boton-menu" text="Administrador&#10;de colaboradores" textAlignment="CENTER" />
            <Button fx:id="btnPacientes" mnemonicParsing="false" onAction="#hableBtnPacientes" prefHeight="110.0" prefWidth="220.0" styleClass="boton-menu" text="Administrador&#10;de pacientes" textAlignment="CENTER" />
            <Button fx:id="btnCitas" mnemonicParsing="false" onAction="#hableBtnCitas" prefHeight="110.0" prefWidth="220.0" styleClass="boton-menu" text="Administrador&#10;de citas" textAlignment="CENTER" />
            <Button fx:id="btnDietas" mnemonicParsing="false" onAction="#hableBtnDietas" prefHeight="110.0" prefWidth="220.0" styleClass="boton-menu" text="Administrador&#10;de dietas" textAlignment="CENTER" />
            <Button fx:id="btnConsultas" mnemonicParsing="false" onAction="#hableBtnConsultas" prefHeight="110.0" prefWidth="220.0" styleClass="boton-menu" text="Consultas" textAlignment="CENTER" />
         </children>
      </FlowPane>
   </children>
</AnchorPane>