<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="560.0" prefWidth="900.0" styleClass="fondo" stylesheets="@../recurso/estilos.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nutricionalappfx.controlador.FXMLAdminPacienteController">
   <children>
      <AnchorPane prefHeight="70.0" styleClass="encabezado" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Button layoutX="20.0" layoutY="17.0" mnemonicParsing="false" onAction="#hableBtnRegresar" styleClass="boton-encabezado" text="←" />
            <Label layoutX="80.0" layoutY="22.0" styleClass="titulo-encabezado" text="Administrador de pacientes" />
         </children>
      </AnchorPane>
      <HBox layoutX="30.0" layoutY="90.0" spacing="10.0">
         <children>
            <TextField fx:id="tfBusqueda" prefWidth="320.0" promptText="Buscar por código o nombre" />
            <Button mnemonicParsing="false" onAction="#hableBtnBuscar" styleClass="boton-secundario" text="Buscar" />
         </children>
      </HBox>
      <HBox spacing="10.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="90.0">
         <children>
            <Button mnemonicParsing="false" onAction="#hableBtnAlta" prefWidth="90.0" styleClass="boton-primario" text="Alta" />
            <Button mnemonicParsing="false" onAction="#hableBtnEditar" prefWidth="90.0" styleClass="boton-secundario" text="Editar" />
            <Button mnemonicParsing="false" onAction="#hableBtnBaja" prefWidth="90.0" styleClass="boton-peligro" text="Baja" />
         </children>
      </HBox>
      <TableView fx:id="tvPacientes" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="145.0">
         <columns>
            <TableColumn fx:id="colCodigo" prefWidth="90.0" text="Código" />
            <TableColumn fx:id="colNombre" prefWidth="140.0" text="Nombre" />
            <TableColumn fx:id="colApellidoPaterno" prefWidth="140.0" text="Apellido paterno" />
            <TableColumn fx:id="colApellidoMaterno" prefWidth="140.0" text="Apellido materno" />
            <TableColumn fx:id="colTelefono" prefWidth="120.0" text="Teléfono" />
            <TableColumn fx:id="colCorreo" prefWidth="200.0" text="Correo" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
         <placeholder>
            <Label styleClass="subtitulo" text="No hay pacientes para mostrar" />
         </placeholder>
      </TableView>
   </children>
</AnchorPane>