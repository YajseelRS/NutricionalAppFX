<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.text.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="560.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nutricionalappfx.controlador.FXMLFormularioPacienteController">
   <children>
      <Button layoutX="20.0" layoutY="20.0" mnemonicParsing="false" onAction="#hableBtnCancelar" text="←" />
      <Label layoutX="70.0" layoutY="18.0" text="Formulario de paciente">
         <font>
            <Font size="20.0" />
         </font>
      </Label>

      <Label layoutX="60.0" layoutY="80.0" text="Código paciente" />
      <TextField fx:id="tfCodigo" disable="true" layoutX="240.0" layoutY="76.0" prefWidth="300.0" promptText="Se genera automáticamente" />

      <Label layoutX="60.0" layoutY="120.0" text="Nombre" />
      <TextField fx:id="tfNombre" layoutX="240.0" layoutY="116.0" prefWidth="300.0" />

      <Label layoutX="60.0" layoutY="160.0" text="Apellido paterno" />
      <TextField fx:id="tfApellidoPaterno" layoutX="240.0" layoutY="156.0" prefWidth="300.0" />

      <Label layoutX="60.0" layoutY="200.0" text="Apellido materno" />
      <TextField fx:id="tfApellidoMaterno" layoutX="240.0" layoutY="196.0" prefWidth="300.0" />

      <Label layoutX="60.0" layoutY="240.0" text="Fecha de nacimiento" />
      <DatePicker fx:id="dpFechaNacimiento" layoutX="240.0" layoutY="236.0" prefWidth="300.0" />

      <Label layoutX="60.0" layoutY="280.0" text="Teléfono de contacto" />
      <TextField fx:id="tfTelefono" layoutX="240.0" layoutY="276.0" prefWidth="300.0" />

      <Separator layoutX="60.0" layoutY="320.0" prefWidth="480.0" />

      <Label layoutX="60.0" layoutY="340.0" text="Sexo" />
      <RadioButton fx:id="rbFemenino" layoutX="240.0" layoutY="340.0" mnemonicParsing="false" text="Femenino">
         <toggleGroup>
            <ToggleGroup fx:id="tgSexo" />
         </toggleGroup>
      </RadioButton>
      <RadioButton fx:id="rbMasculino" layoutX="350.0" layoutY="340.0" mnemonicParsing="false" text="Masculino" toggleGroup="$tgSexo" />

      <Label layoutX="60.0" layoutY="380.0" text="Altura (m)" />
      <TextField fx:id="tfAltura" layoutX="240.0" layoutY="376.0" prefWidth="300.0" promptText="Ejemplo: 1.65" />

      <Label layoutX="60.0" layoutY="420.0" text="Peso inicial (kg)" />
      <TextField fx:id="tfPesoInicial" layoutX="240.0" layoutY="416.0" prefWidth="300.0" promptText="Ejemplo: 62.5" />

      <Label layoutX="60.0" layoutY="460.0" text="Correo electrónico" />
      <TextField fx:id="tfCorreo" layoutX="240.0" layoutY="456.0" prefWidth="300.0" />

      <Button layoutX="370.0" layoutY="510.0" mnemonicParsing="false" onAction="#hableBtnGuardar" prefWidth="80.0" text="Guardar" />
      <Button layoutX="460.0" layoutY="510.0" mnemonicParsing="false" onAction="#hableBtnCancelar" prefWidth="80.0" text="Cancelar" />
   </children>
</AnchorPane>